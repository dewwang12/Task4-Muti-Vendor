# ==============================================================================
# MarketHub — Multi-Vendor E-Commerce Environment Configuration Blueprint
# DO NOT COMMIT ACTUAL SENSITIVE CREDENTIALS TO SOURCE CONTROL
# Copy this file to .env and adjust variables for your local setup.
# ==============================================================================

# Server & Application Ports
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16+)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/markethub?schema=public"

# Redis Cache & Background Jobs (Optional in local development; fallback is in-memory)
REDIS_URL="redis://localhost:6379"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="your_jwt_access_secret_min_32_chars_random_string_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_min_32_chars_random_string_here"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Marketplace Commission Defaults
# Commission rate in Basis Points (1000 bps = 10.00%)
DEFAULT_COMMISSION_RATE_BPS=1000

# File Storage Configuration (S3 / Compatible or Local fallback)
# Options: "local" | "s3"
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_BUCKET="markethub-uploads"
S3_REGION="ap-south-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
LOCAL_UPLOAD_DIR="./uploads"

# Payment Provider Configuration
# Options: "mock" | "stripe" | "razorpay"
PAYMENT_PROVIDER="mock"
PAYMENT_PUBLIC_KEY="mock_pk_test_123456"
PAYMENT_SECRET_KEY="mock_sk_test_654321"
PAYMENT_WEBHOOK_SECRET="mock_whsec_987654"

# Next.js Frontend Public Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_NAME="MarketHub"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_DEFAULT_COMMISSION_RATE="10%"
